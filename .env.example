# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- language models ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_MODEL=mistral
USE_LOCAL_LLM=false

# --- speech ---
STT_BACKEND=faster-whisper
# small beats base by 0.256 vs 0.310 WER on the test set and is still realtime
# on CPU (0.67 xRT). cpu/int8 is pinned rather than probed; use auto for CUDA.
STT_MODEL_SIZE=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
TTS_BACKEND=piper
LANGUAGE=fr

# --- embeddings ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- audio front end ---
# normalize() brings every clip to this RMS, with the peak limited below.
TARGET_RMS_DBFS=-20.0
PEAK_CEILING=0.99
# check() rejects a clip that fails any of these.
MIN_SPEECH_RATIO=0.10
MAX_CLIPPING_RATIO=0.01
MIN_DURATION_S=0.30
# A clean clip's noise floor is near zero, so the SNR estimate is capped.
MAX_SNR_DB=60.0

# --- thresholds ---
# MIN_SNR_DB and MIN_CONFIDENCE are calibrated against measured WER by
# scripts/calibrate_gate.py, not chosen by hand. Re-run it if the audio set or
# the model changes.
MIN_SNR_DB=11.2
MIN_CONFIDENCE=0.62
INTENT_ACCEPT_THRESHOLD=0.55
INTENT_MARGIN=0.08
FAQ_ACCEPT_THRESHOLD=0.60
EXAM_FUZZY_THRESHOLD=82
FRUSTRATION_ESCALATE_THRESHOLD=0.70
MAX_TURNS_BEFORE_ESCALATION=8

# --- logging ---
LOG_SALT=change-me
LOG_LEVEL=INFO
