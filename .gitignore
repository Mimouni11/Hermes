# --- secrets ---
.env

# --- virtual environment ---
.venv/
venv/
env/

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- trained weights ---
# `models/**` rather than `models/`: the directory form stops git descending,
# so the .gitkeep negation below would never be reached and the folder would
# vanish from a clone.
models/**
!models/**/
!models/.gitkeep

# --- data ---
# Nothing under data/ is committed: not the corpora, not the audio, not the
# generated database. Only the .gitkeep files, so the directory layout survives
# a clone and the scripts have somewhere to write.
data/**
!data/**/
!data/**/.gitkeep

# The rules below are redundant while data/** stands, and deliberately kept:
# they still hold if that line is ever relaxed to commit the corpora. Note they
# are all *file* patterns — a directory-form rule like `data/processed/` would
# stop git descending and swallow the .gitkeep that keeps the folder alive.
# Audio clips never go in the repo (Rule 3). The subdirectory patterns matter:
# `data/audio/*.wav` alone misses tts/, recorded/, noisy/ and noise/.
data/audio/*.wav
data/audio/*.mp3
data/audio/**/*.wav
data/audio/**/*.mp3
# Whatever a phone or a laptop records to, before convert_recordings.py turns
# it into WAV. A recording of a real voice is exactly what Rule 3 is about.
data/audio/**/*.m4a
data/audio/**/*.aac
data/audio/**/*.opus
data/audio/**/*.ogg
data/audio/**/*.flac
data/audio/**/*.webm
data/audio/**/*.mp4
data/audio/**/*.3gp
data/audio/**/*.amr
data/audio/**/*.wma
data/audio/**/*.aiff
data/audio/**/*.caf
# manifest.csv is not committed either. It is regenerable: pick_audio_sentences.py
# is seeded, so the same 20 sentences and the same split come back on any machine.

# --- generated reports ---
# Split on purpose, by whether a human reads it or a script does:
#
#   *.csv  per-case tables. Thousands of rows, rewritten on every run, and
#          they would churn the diff for no review value. Ignored.
#   *.md   the written summaries. Few, stable, and they carry the measurements
#          the docs and the report cite — so they are committed and reviewed
#          like any other prose.
#
# Keep the directories so the scripts have somewhere to write.
reports/*.csv
reports/figures/*
!reports/figures/.gitkeep

# --- logs ---
*.log
logs/

# --- project documents ---
# The brief and any other handouts stay out of the repo.
*.pdf
*.docx
*.pptx

# --- os / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
